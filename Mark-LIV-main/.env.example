# Google Gemini API key (Required for Gemini AI integration)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Assistant Configuration
JARVIS_NAME=JARVIS
JARVIS_MODE=HYBRID
WAKE_WORD=jarvis

# Network & Timeout
DEFAULT_TIMEOUT_SEC=10
OFFLINE_FALLBACK=true

# Security Settings
REQUIRE_CONFIRMATION_FOR_DESTRUCTIVE=true
ALLOW_SYSTEM_POWER_COMMANDS=true
